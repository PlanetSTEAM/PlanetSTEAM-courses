project:
  type: website
  output-dir: docs

website:
  title: "Planet STEAM Academy"
  navbar:
    left:
      - href: index.html
        text: Home

format:
  html:
    theme: darkly
    toc: true
    number-sections: true
    code-fold: false
    code-tools: true
    execute:
      freeze: false
      eval: true
      warning: false
      message: false
